rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if userId is string 
        && userId.size() <= 128
        && request.resource.data.username is string;
      allow delete: if false;
    }
  }
}
